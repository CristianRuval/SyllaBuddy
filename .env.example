# ==============================================================================
# SyllaBuddy Production Environment Template
# Copy to .env (`cp .env.example .env`) and fill in real values before running
# `docker compose up -d --build`. NEVER commit .env to git.
# ==============================================================================

# --- Runtime & Origin ---
ENV=production
PORT=8080
APP_BASE_URL=https://syllabuddy.me
COOKIE_SECURE=true
# Max uploaded PDF size in bytes (default 15 MiB = 15728640; Caddy allows 20MB)
MAX_UPLOAD_BYTES=15728640

# --- Embedded SQLite Database ---
DB_PATH=/app/data/syllabuddy.db

# --- Authentication & Sessions ---
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-64-char-random-hex-secret
# Session lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional: set a code to gate new registrations; leave empty for open beta signup
BETA_INVITE_CODE=

# --- AI PDF Parsing (Required) ---
# Create in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key

# --- Google Sign-In & Calendar Sync (Optional) ---
# OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
